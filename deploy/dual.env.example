# Values for deploy/compose.dual.yml. Copy to ".env" beside it and set every one.
# All addresses below are documentation examples: replace them with yours.

# The client LAN: where MCP clients are.
UNIFI_MCP_CLIENT_NIC=eth0
UNIFI_MCP_CLIENT_SUBNET=198.51.100.0/24
UNIFI_MCP_CLIENT_IP=198.51.100.10
# The host name clients use, which must be in the MCP certificate.
UNIFI_MCP_PUBLIC_NAME=mcp.example.lan

# The management LAN: where the UniFi consoles are (or the router or VPN towards them).
UNIFI_MCP_MANAGEMENT_NIC=eth1
UNIFI_MCP_MANAGEMENT_SUBNET=192.0.2.0/24
UNIFI_MCP_MANAGEMENT_GATEWAY=192.0.2.254
UNIFI_MCP_MANAGEMENT_IP=192.0.2.10

# The only addresses the service may contact as consoles (comma-separated).
UNIFI_MCP_CONSOLE_CIDRS=192.0.2.1/32

# The user that owns ./data and ./secrets (id -u, id -g).
UNIFI_MCP_UID=1000
UNIFI_MCP_GID=1000
