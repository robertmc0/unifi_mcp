# Secrets and local configuration (spec §8.3)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
master.key

# Runtime data: SQLite databases, backups, logs
/data/
.data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.log
logs/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
