# unifi-local-mcp — illustrative, NON-SECRET example values only (spec §8.3).
# Copy to .env and adjust. Never put real API keys, passwords, tokens, encryption keys,
# deployment hostnames or addresses in example files.
#
# Which variables are immutable deployment overrides and which are bootstrap-only is
# defined in docs/configuration.md (Phase 1). UNIFI_MCP_FORCE_READ_ONLY is an immutable
# deployment override: when true (or unset), no write can execute through any path.

NODE_ENV=production
UNIFI_MCP_DATA_DIR=/data
UNIFI_MCP_FORCE_READ_ONLY=true

# MCP listener. 0.0.0.0 is safe ONLY when host-level bind/firewall/TLS controls enforce the
# intended exposure (see docs/networking.md). Without TLS files, a non-loopback bind also
# needs UNIFI_MCP_HTTP_ALLOW_PLAINTEXT=true, e.g. when Compose publishes 127.0.0.1:3000:3000.
UNIFI_MCP_HTTP_BIND=0.0.0.0
UNIFI_MCP_HTTP_PORT=3000
UNIFI_MCP_HTTP_ALLOW_PLAINTEXT=true
# UNIFI_MCP_HTTP_TLS_CERT_FILE=/run/secrets/mcp_tls_cert
# UNIFI_MCP_HTTP_TLS_KEY_FILE=/run/secrets/mcp_tls_key
# Extra Host header names accepted on /mcp (local names are always accepted):
# UNIFI_MCP_HTTP_ALLOWED_HOSTS=mcp.example.invalid

# Consoles the service may connect to (default: private ranges, CGNAT, IPv6 ULA).
# UNIFI_MCP_EGRESS_ALLOW_CIDRS=192.168.1.0/24
UNIFI_MCP_AUDIT_RETENTION_DAYS=90

# Admin web interface: disabled by default; separate bind/port/certificate; loopback by
# default. In Docker, bind 0.0.0.0 with ALLOW_PLAINTEXT and publish 127.0.0.1:3001:3001 only.
UNIFI_MCP_ADMIN_ENABLED=false
UNIFI_MCP_ADMIN_BIND=127.0.0.1
UNIFI_MCP_ADMIN_PORT=3001
# UNIFI_MCP_ADMIN_TLS_CERT_FILE=/run/secrets/admin_tls_cert
# UNIFI_MCP_ADMIN_TLS_KEY_FILE=/run/secrets/admin_tls_key
# UNIFI_MCP_ADMIN_ALLOW_PLAINTEXT=false
# UNIFI_MCP_ADMIN_ALLOWED_HOSTS=admin.example.invalid
# UNIFI_MCP_ADMIN_SESSION_IDLE_MINUTES=30
# UNIFI_MCP_ADMIN_SESSION_MAX_HOURS=12

# Master encryption key: prefer a Docker secret / read-only mounted file (docs/configuration.md).
# Fallback, less isolated: UNIFI_MCP_MASTER_KEY=<44-character base64 key>. Never set both.
UNIFI_MCP_MASTER_KEY_FILE=/run/secrets/unifi_mcp_master_key

UNIFI_MCP_METRICS_ENABLED=false
UNIFI_MCP_ONLINE_CHECKS_ENABLED=false
UNIFI_MCP_LOG_LEVEL=info
