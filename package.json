{
  "name": "unifi-local-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted MCP server for official local UniFi application APIs (Network, Protect, Access).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "unifi-mcp": "node packages/cli/src/main.ts",
    "api:fetch-specs": "node scripts/fetch-api-specs.ts",
    "api:reconcile": "node scripts/reconcile-api-coverage.ts",
    "api:coverage-report": "node scripts/generate-coverage-report.ts"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
